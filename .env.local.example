# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Provider (OpenRouter) ──────────────────────────────────────────────────
#   Docs   : https://openrouter.ai/docs
OPENROUTER_API_KEY=

# Setup/Analysis model (e.g. extracting chat history, brand voice)
GLIM_SETUP_MODEL=z-ai/glm-5.3-flash

# Draft/Chat message generation model (fast real-time inference)
GLIM_DRAFT_MODEL=qwen/qwen3.8-flash
# ─────────────────────────────────────────────────────────────────────────────

# RAG — Embeddings
# Used to embed business knowledge chunks for semantic retrieval (RAG).
# If unset, the app falls back to context-stuffing (full knowledge in every prompt).
#
# Option A: Direct OpenAI key (Recommended, cheapest — text-embedding-3-small ~$0.02/1M tokens)
# OPENAI_API_KEY=sk-...
#
# Option B: Use OpenRouter for embeddings
# Your existing OPENROUTER_API_KEY will be used automatically.
# By default, it uses 'openai/text-embedding-3-small'.
# You can change it to Qwen or others, but note that the database uses 1536 dimensions.
# 'qwen/qwen3-embedding-4b' may require recreating the pgvector table if dimensions differ!
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# ─────────────────────────────────────────────────────────────────────────────

# WhatsApp Service (rostra-wa)
WA_SERVICE_URL=http://localhost:3001
WEBHOOK_SECRET=

# App — fill with Vercel URL after first deploy
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Invite code for registration
INVITE_CODE=

# Beta mode — lowers Level 2 threshold from 50 to 5, Level 3 from 200 to 20
NEXT_PUBLIC_BETA_MODE=false

# Payment Gateway (Xendit)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=

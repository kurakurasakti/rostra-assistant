# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Provider — pick ONE ──────────────────────────────────────────────────
#
# Option A: DeepSeek (recommended — supports prompt caching, 50x cheaper on cache hit)
#   Docs   : https://platform.deepseek.com/api-docs
#   Models : deepseek-chat (V3/V4 Flash), deepseek-reasoner (R1)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Real-time tasks (draft, classify) — non-thinking alias, valid until 2026-07-24
DEEPSEEK_CHAT_MODEL=deepseek-chat
# Analysis tasks (brand voice, business knowledge) — thinking enabled for quality
DEEPSEEK_MODEL=deepseek-v4-flash

# Option B: OpenRouter (fallback — used only if DEEPSEEK_API_KEY is empty)
#   Docs   : https://openrouter.ai/docs
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-flash-1.5
OPENROUTER_ANALYSIS_MODEL=
# ─────────────────────────────────────────────────────────────────────────────

# RAG — Embeddings
# Used to embed business knowledge chunks for semantic retrieval (RAG).
# If unset, the app falls back to context-stuffing (full knowledge in every prompt).
#
# Option A: Direct OpenAI key (Recommended, cheapest — text-embedding-3-small ~$0.02/1M tokens)
# OPENAI_API_KEY=sk-...
#
# Option B: Use OpenRouter for embeddings
# Your existing OPENROUTER_API_KEY will be used automatically.
# By default, it uses 'openai/text-embedding-3-small'.
# You can change it to Qwen or others, but note that the database uses 1536 dimensions.
# 'qwen/qwen3-embedding-4b' may require recreating the pgvector table if dimensions differ!
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# ─────────────────────────────────────────────────────────────────────────────

# WhatsApp Service (rostra-wa)
WA_SERVICE_URL=http://localhost:3001
WEBHOOK_SECRET=

# App — fill with Vercel URL after first deploy
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Invite code for registration
INVITE_CODE=

# Beta mode — lowers Level 2 threshold from 50 to 5, Level 3 from 200 to 20
NEXT_PUBLIC_BETA_MODE=false

# Payment Gateway (Xendit)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=
